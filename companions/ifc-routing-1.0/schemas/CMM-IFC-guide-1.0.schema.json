{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMM 1.0 IFC routing guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "guide_version", "status", "cmm_edition", "cmm_canonical_sha256", "source_review_sha256", "quantity_policy", "counts", "items"],
  "properties": {
    "title": {"const": "CMM 1.0 IFC routing guide"},
    "guide_version": {"const": "1.0"},
    "status": {"const": "public_guidance_not_automatic_measurement"},
    "cmm_edition": {"const": "1.0"},
    "cmm_canonical_sha256": {"const": "8e227a98b038a2eb5bd10527fd311d496b1f5e43380564d13fb75c1744a3ff2c"},
    "source_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quantity_policy": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_for_estimator_review", "requires_information", "no_safe_route_with_current_evidence", "not_normally_modelled"],
      "properties": {
        "candidate_for_estimator_review": {"const": 239},
        "requires_information": {"const": 300},
        "no_safe_route_with_current_evidence": {"const": 82},
        "not_normally_modelled": {"const": 180}
      }
    },
    "items": {"type": "array", "minItems": 801, "maxItems": 801, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "versions": {
      "type": "object", "additionalProperties": false, "required": ["4.0", "4.3"],
      "properties": {
        "4.0": {"enum": ["supported", "unsupported", "review_required", "not_applicable"]},
        "4.3": {"enum": ["supported", "unsupported", "review_required", "not_applicable"]}
      }
    },
    "possibleIfc": {
      "type": "object", "additionalProperties": false, "required": ["object", "type", "versions"],
      "properties": {
        "object": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
        "type": {"type": ["string", "null"]},
        "versions": {"$ref": "#/$defs/versions"}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["ifc_object", "ifc_type", "ifc_versions", "selection_status"],
      "properties": {
        "ifc_object": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
        "ifc_type": {"type": ["string", "null"]},
        "ifc_versions": {"$ref": "#/$defs/versions"},
        "selection_status": {"enum": ["candidate", "requires_information", "not_applicable"]}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["cmm_id", "title", "unit", "status", "possible_ifc", "routes", "reason", "route_source", "estimator_review_required"],
      "properties": {
        "cmm_id": {"type": "string", "pattern": "^cmm\\.item\\.[0-9]{2}\\.[A-Z0-9]+\\.[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate_for_estimator_review", "requires_information", "no_safe_route_with_current_evidence", "not_normally_modelled"]},
        "possible_ifc": {"anyOf": [{"$ref": "#/$defs/possibleIfc"}, {"type": "null"}]},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
        "reason": {"type": "string", "minLength": 1},
        "route_source": {"enum": ["current_item_review", "existing_exact_identity_review"]},
        "estimator_review_required": {"const": true}
      }
    }
  }
}
